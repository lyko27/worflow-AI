{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-3-7-sonnet",
  "small_model": "google/gemini-2.0-flash",
  "default_agent": "build",
  "subagent_depth": 1,
  "instructions": [
    ".opencode/AGENTS.md",
    "docs/opencode/packages/web/src/content/docs/agents.mdx",
    "docs/opencode/packages/web/src/content/docs/permissions.mdx"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@executeautomation/playwright-mcp-server"
      ],
      "enabled": true
    },
    "duckduckgo": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-duckduckgo"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "duckduckgo_*": "allow",
    "playwright_*": "allow",
    "todowrite": "allow",
    "question": "ask",
    "bash": {
      "*": "allow",
      "rm -rf /": "deny",
      "rm -rf /root": "deny",
      "rm -rf /etc": "deny",
      "rm -rf ~": "deny",
      "git push": "ask"
    }
  }
}
