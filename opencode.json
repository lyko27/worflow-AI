{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-3-7-sonnet",
  "small_model": "google/gemini-2.0-flash",
  "default_agent": "build",
  "subagent_depth": 1,
  "instructions": [
    ".opencode/AGENTS.md",
    "docs/opencode/README.md"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@executeautomation/playwright-mcp-server"
      ],
      "enabled": true
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "question": "ask",
    "bash": {
      "rm -rf /": "deny",
      "rm -rf /root": "deny",
      "rm -rf /etc": "deny",
      "git push": "ask",
      "*": "allow"
    }
  }
}
